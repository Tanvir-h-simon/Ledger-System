<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane style="-fx-background-color: #f7f9fc; -fx-padding: 24 40;"
           xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.ledgersystem.controller.SavingsController">

    <VBox spacing="12" maxWidth="520" alignment="TOP_LEFT"
          style="-fx-background-color: white;
                 -fx-background-radius: 10;
                 -fx-border-color: #e2e8f0;
                 -fx-border-width: 1.5;
                 -fx-border-radius: 10;">
        <padding>
            <Insets top="28" right="36" bottom="28" left="36"/>
        </padding>

        <Label text="Savings"
               style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #1e293b;"/>

        <VBox spacing="6"
              style="-fx-background-color: #eff6ff; -fx-background-radius: 8; -fx-padding: 14;">
            <Label fx:id="statusLabel"
                   style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #1d4ed8;"/>
            <Label fx:id="percentLabel" style="-fx-text-fill: #374151;"/>
            <Label fx:id="totalLabel"
                   style="-fx-font-weight: bold; -fx-text-fill: #1d4ed8;"/>
        </VBox>

        <Label text="Set Savings Percentage (1 – 100)"
               style="-fx-font-weight: bold; -fx-text-fill: #374151;"/>
        <TextField fx:id="percentageField" promptText="e.g. 10" maxWidth="Infinity"/>

        <Label fx:id="messageLabel" wrapText="true"/>

        <HBox spacing="12">
            <Button text="Enable Savings"  prefWidth="190" onAction="#handleEnable"
                    style="-fx-background-color: #16a34a;"/>
            <Button text="Disable Savings" prefWidth="190" onAction="#handleDisable"
                    style="-fx-background-color: #dc2626;"/>
        </HBox>
    </VBox>

</StackPane>
