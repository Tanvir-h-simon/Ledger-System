<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.LineChart?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.chart.PieChart?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="10"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.ledgersystem.controller.ChartsController">
    <padding>
        <Insets top="20" right="24" bottom="20" left="24"/>
    </padding>

    <Label text="Charts"
           style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #1e293b;"/>

    <TabPane tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS">
        <tabs>

            <!-- Tab 1: Spending by category (blue) -->
            <Tab text="📊 Spending by Category">
                <content>
                    <VBox spacing="8" style="-fx-background-color: white; -fx-padding: 18;">
                        <Label text="📊  Spending by Category"
                               style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #3b82f6;"/>
                        <Label text="Distribution of all credit transactions across categories"
                               style="-fx-text-fill: #94a3b8; -fx-font-size: 12px;"/>
                        <PieChart fx:id="categoryChart" VBox.vgrow="ALWAYS"
                                  prefHeight="420" animated="true" legendVisible="true"/>
                    </VBox>
                </content>
            </Tab>

            <!-- Tab 2: Balance over time (green) -->
            <Tab text="📈 Balance Over Time">
                <content>
                    <VBox spacing="8" style="-fx-background-color: white; -fx-padding: 18;">
                        <Label text="📈  Balance Over Time"
                               style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #16a34a;"/>
                        <Label text="Running account balance at the end of each month"
                               style="-fx-text-fill: #94a3b8; -fx-font-size: 12px;"/>
                        <LineChart fx:id="balanceChart" VBox.vgrow="ALWAYS"
                                   prefHeight="420" animated="true">
                            <xAxis><CategoryAxis label="Month"/></xAxis>
                            <yAxis><NumberAxis label="Balance (RM)"/></yAxis>
                        </LineChart>
                    </VBox>
                </content>
            </Tab>

            <!-- Tab 3: Loan repayment (orange) -->
            <Tab text="🏦 Loan Repayment">
                <content>
                    <VBox spacing="8" style="-fx-background-color: white; -fx-padding: 18;">
                        <Label text="🏦  Loan Repayment Progress"
                               style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #d97706;"/>
                        <Label text="Remaining outstanding balance vs. original principal"
                               style="-fx-text-fill: #94a3b8; -fx-font-size: 12px;"/>
                        <BarChart fx:id="loanChart" VBox.vgrow="ALWAYS"
                                  prefHeight="420" animated="true">
                            <xAxis><CategoryAxis/></xAxis>
                            <yAxis><NumberAxis label="Amount (RM)"/></yAxis>
                        </BarChart>
                    </VBox>
                </content>
            </Tab>

        </tabs>
    </TabPane>
</VBox>
