<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.ledgersystem.controller.DashboardController"
            style="-fx-background-color: #f7f9fc;">

    <!-- Top bar: welcome + overdue loan banner -->
    <top>
        <VBox style="-fx-background-color: #ffffff; -fx-border-color: #e2e8f0; -fx-border-width: 0 0 1.5 0;">
            <padding>
                <Insets top="14" right="24" bottom="14" left="24"/>
            </padding>
            <Label fx:id="welcomeLabel"
                   style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #212121;"/>
            <Label fx:id="overdueBanner"
                   text="⚠  Your loan is overdue! Please repay it before recording new transactions."
                   visible="false" managed="false"
                   style="-fx-text-fill: white; -fx-background-color: #dc2626;
                          -fx-padding: 7 14; -fx-font-weight: bold; -fx-background-radius: 6;"/>
        </VBox>
    </top>

    <!-- Left nav sidebar: dark teal #0b1d30 per design spec -->
    <left>
        <VBox spacing="4" minWidth="215"
              style="-fx-background-color: #0b1d30;">
            <padding>
                <Insets top="24" right="12" bottom="24" left="12"/>
            </padding>

            <!-- Logo section -->
            <VBox spacing="2" alignment="CENTER_LEFT" style="-fx-padding: 0 4 20 4;">
                <Label text="💰"
                       style="-fx-font-size: 26px; -fx-background-color: #1f344e;
                              -fx-background-radius: 8; -fx-padding: 4 10;"/>
                <Label text="LEDGER SYSTEM"
                       style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #ffffff;
                              -fx-padding: 6 0 0 2;"/>
            </VBox>

            <Label text="MENU"
                   style="-fx-text-fill: #475569; -fx-font-size: 10px; -fx-font-weight: bold; -fx-padding: 0 0 4 6;"/>

            <!-- Nav items per design spec -->
            <Button text="🏠  Dashboard"   styleClass="nav-btn" maxWidth="Infinity" onAction="#handleShowHome"/>
            <Button text="💳  Transactions" styleClass="nav-btn" maxWidth="Infinity" onAction="#handleShowTransaction"/>
            <Button text="📋  History"      styleClass="nav-btn" maxWidth="Infinity" onAction="#handleShowHistory"/>
            <Button text="💰  Savings"      styleClass="nav-btn" maxWidth="Infinity" onAction="#handleShowSavings"/>
            <Button text="🏦  Loans"        styleClass="nav-btn" maxWidth="Infinity" onAction="#handleShowLoan"/>
            <Button text="📈  Predictor"    styleClass="nav-btn" maxWidth="Infinity" onAction="#handleShowPredictor"/>
            <Button text="📊  Charts"       styleClass="nav-btn" maxWidth="Infinity" onAction="#handleShowCharts"/>

            <!-- Spacer pushes Logout to the bottom -->
            <Region VBox.vgrow="ALWAYS"/>

            <Separator style="-fx-opacity: 0.3;"/>
            <Button text="🚪  Logout" styleClass="logout-btn" maxWidth="Infinity" onAction="#handleLogout"/>
        </VBox>
    </left>

    <!-- Center: sub-views are swapped in here -->
    <center>
        <StackPane fx:id="centerPane" style="-fx-background-color: #f7f9fc;"/>
    </center>

</BorderPane>
