<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane style="-fx-background-color: #f7f9fc; -fx-padding: 24 40;"
           xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.ledgersystem.controller.HistoryController">

    <VBox spacing="12" maxWidth="900" alignment="TOP_LEFT"
          style="-fx-background-color: white;
                 -fx-background-radius: 10;
                 -fx-border-color: #e2e8f0;
                 -fx-border-width: 1.5;
                 -fx-border-radius: 10;">
        <padding>
            <Insets top="28" right="36" bottom="28" left="36"/>
        </padding>

        <Label text="Transaction History"
               style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #1e293b;"/>

        <HBox spacing="12" alignment="CENTER_LEFT">
            <ComboBox fx:id="monthFilterBox" promptText="Month"   prefWidth="140"/>
            <ComboBox fx:id="sortBox"        promptText="Sort By" prefWidth="220"/>
            <Button text="Apply" prefWidth="90"  onAction="#handleApplyFilters"/>
            <Button text="Reset" prefWidth="90"  onAction="#handleReset"
                    style="-fx-background-color: #64748b;"/>
        </HBox>

        <Label text="date  |  type  |  category  |  amount  |  description"
               style="-fx-text-fill: #94a3b8; -fx-font-size: 11px;"/>

        <!-- ListView grows to fill all remaining card height -->
        <ListView fx:id="transactionList" VBox.vgrow="ALWAYS"/>

        <HBox spacing="14" alignment="CENTER_LEFT">
            <Label fx:id="messageLabel" wrapText="true" HBox.hgrow="ALWAYS"/>
            <Button text="Export to CSV" onAction="#handleExport"
                    style="-fx-background-color: #0891b2;"/>
        </HBox>
    </VBox>

</StackPane>
