<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane style="-fx-background-color: #f7f9fc;"
           xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.ledgersystem.controller.RegisterController">

    <VBox alignment="CENTER" spacing="12" maxWidth="380">

        <Label text="💰" style="-fx-font-size: 40px;"/>
        <Label text="Create Account"
               style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #1e293b;"/>
        <Label text="Start managing your finances today"
               style="-fx-font-size: 13px; -fx-text-fill: #64748b;"/>

        <VBox spacing="8" style="-fx-padding: 14 0 0 0;">
            <Label text="Full Name" style="-fx-font-weight: bold; -fx-text-fill: #374151;"/>
            <TextField fx:id="nameField" promptText="Your name" maxWidth="Infinity"/>

            <Label text="Email" style="-fx-font-weight: bold; -fx-text-fill: #374151;"/>
            <TextField fx:id="emailField" promptText="you@example.com" maxWidth="Infinity"/>

            <Label text="Password" style="-fx-font-weight: bold; -fx-text-fill: #374151;"/>
            <PasswordField fx:id="passwordField" promptText="Create a password" maxWidth="Infinity"/>

            <Label text="Confirm Password" style="-fx-font-weight: bold; -fx-text-fill: #374151;"/>
            <PasswordField fx:id="confirmPasswordField" promptText="Repeat your password" maxWidth="Infinity"/>
        </VBox>

        <Label fx:id="errorLabel" wrapText="true" style="-fx-text-fill: #dc2626;"/>

        <Button text="Create Account" maxWidth="Infinity" onAction="#handleRegister"/>

        <Button text="Already have an account? Sign In"
                maxWidth="Infinity"
                onAction="#handleGoToLogin"
                style="-fx-background-color: transparent;
                       -fx-text-fill: #3b82f6;
                       -fx-effect: none;
                       -fx-font-weight: normal;
                       -fx-cursor: hand;"/>
    </VBox>
</StackPane>
